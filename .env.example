# Neon (injected by Vercel Marketplace → Neon)
DATABASE_URL=

# Site login (shared password). When set, all pages require login.
SITE_PASSWORD=
# Signs the session cookie (required when SITE_PASSWORD is set). Falls back to CRON_SECRET if unset.
AUTH_SECRET=

# Cron / manual sync
CRON_SECRET=
# Optional separate secret for POST /api/sync from settings UI
# SYNC_SECRET=

# Optional one-time IMDb CSV bootstrap only (MovieMon/Neon is the ongoing source of truth).
# Export: open watchlist → ⋯ → Export. Prefer POST /api/sync with csvText; URL is optional.
# IMDB_WATCHLIST_CSV_URL=
# HTML scrape is blocked by AWS WAF — not used.

# Availability (Watchmode)
WATCHMODE_API_KEY=
