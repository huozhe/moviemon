# Neon (injected by Vercel Marketplace → Neon)
DATABASE_URL=

# Cron / manual sync
CRON_SECRET=
# Optional separate secret for POST /api/sync from settings UI
# SYNC_SECRET=

# IMDb watchlist source (CSV recommended — IMDb blocks HTML scrapes with AWS WAF)
# Export from IMDb: open watchlist → ⋯ menu → Export → host the .csv (Gist raw URL, etc.)
IMDB_WATCHLIST_CSV_URL=
# Optional HTML URL (usually fails server-side; kept for docs / future)
# IMDB_WATCHLIST_URL=https://www.imdb.com/user/urXXXXXXXX/watchlist

# Availability (Watchmode)
WATCHMODE_API_KEY=
